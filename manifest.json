{
  "manifest_version": 3,
  "name": "Attention Guard",
  "version": "1.0.0",
  "description": "Points out the attention-grabbing tricks websites use while you study.",
  "minimum_chrome_version": "105",

  "permissions": ["storage", "declarativeNetRequest", "alarms"],

  "optional_host_permissions": ["*://*/*"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Attention Guard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "content/techniques.js",
        "content/ui.js",
        "content/common.js",
        "content/youtube.js"
      ],
      "css": ["content/ui.css", "content/youtube.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "content/techniques.js",
        "content/ui.js",
        "content/common.js",
        "content/reddit.js"
      ],
      "css": ["content/ui.css", "content/reddit.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.wikipedia.org/*"],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "content/techniques.js",
        "content/ui.js",
        "content/common.js",
        "content/wikipedia.js"
      ],
      "css": ["content/ui.css", "content/wikipedia.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://discord.com/*"],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "content/techniques.js",
        "content/ui.js",
        "content/common.js",
        "content/discord.js"
      ],
      "css": ["content/ui.css", "content/discord.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nytimes.com/*"],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "content/techniques.js",
        "content/ui.js",
        "content/common.js",
        "content/nyt.js"
      ],
      "css": ["content/ui.css", "content/nyt.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://*.wikipedia.org/*",
        "https://discord.com/*",
        "https://www.nytimes.com/*"
      ]
    },
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
