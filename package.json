{
  "name": "attention-sentry",
  "version": "1.0.0",
  "private": true,
  "description": "Development tooling for the Attention Sentry Chrome extension. Nothing here ships.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.js",
    "format": "prettier --write \"**/*.{js,ts,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,css,html}\"",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
